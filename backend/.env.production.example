# =============================================================================
# DevCenterPoint ProERP — Backend Production Environment Template
# Target: Websuru cPanel Hosting — MySQL — Apache — No Docker — No Redis
# Platform: proerp.devcenterpoint.com
# Tenants: {slug}.devcenterpoint.com + verified custom domains
#
# Usage:
#   cp .env.production.example .env
#   php artisan key:generate
#   Fill in database credentials and secrets marked REPLACE_THIS
# =============================================================================

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------
APP_NAME="DevCenterPoint ProERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://proerp.devcenterpoint.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Platform & Domain Identity
# -----------------------------------------------------------------------------
PLATFORM_NAME="DevCenterPoint"
MASTER_DOMAIN=proerp.devcenterpoint.com
TENANT_BASE_DOMAIN=devcenterpoint.com

# -----------------------------------------------------------------------------
# Database — MySQL via Websuru cPanel
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_USERNAME_dbname
DB_USERNAME=CPANEL_USERNAME_dbuser
DB_PASSWORD=REPLACE_THIS_STRONG_PASSWORD_32_CHARS_MIN
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# -----------------------------------------------------------------------------
# Cache & Queue — Database driven for cPanel compatibility
# -----------------------------------------------------------------------------
CACHE_STORE=database
CACHE_PREFIX=proerp_cache
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Session — Database driven
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.devcenterpoint.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Logging — Daily rotating logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Custom JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=REPLACE_THIS_64_CHAR_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_HERE
JWT_TTL=900
REFRESH_TOKEN_TTL=1209600

# -----------------------------------------------------------------------------
# Filesystem & Storage
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail Configuration (cPanel SMTP)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.devcenterpoint.com
MAIL_PORT=465
MAIL_USERNAME=noreply@devcenterpoint.com
MAIL_PASSWORD=REPLACE_THIS_MAIL_PASSWORD
MAIL_FROM_ADDRESS=noreply@devcenterpoint.com
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Broadcast (Disabled / Log driver for cPanel)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://proerp.devcenterpoint.com
