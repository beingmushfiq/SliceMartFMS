# =====================================================================
# SliceMart FMS — Canonical Production Environment Configuration
# Target: Stage 1 Multi-Tenant Single-Node Containerized Deployment
# =====================================================================

# ---------------------------------------------------------------------
# Application Core
# ---------------------------------------------------------------------
APP_NAME="SliceMart FMS"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://app.slicemart.com

LOG_CHANNEL=daily
LOG_LEVEL=error

# ---------------------------------------------------------------------
# Database Persistence (PostgreSQL 16 / MySQL 8.0)
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=slicemart_production
DB_USERNAME=slicemart_app
DB_PASSWORD=ReplaceWithStrongPassword32CharsMin!

# ---------------------------------------------------------------------
# Cache & Session Stores (Stage 1: Database Drivers, Zero Redis Complexity)
# ---------------------------------------------------------------------
CACHE_STORE=database
CACHE_PREFIX=slicemart_cache

QUEUE_CONNECTION=database

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------------
# JWT Cryptographic Authentication
# ---------------------------------------------------------------------
JWT_SECRET=ReplaceWithCryptographicallySecureRandom64CharSecretKeyForJwtSigning
JWT_TTL=900
REFRESH_TOKEN_TTL=1209600

# ---------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.slicemart.com,https://pos.slicemart.com,https://store.slicemart.com

# ---------------------------------------------------------------------
# Frontend Environment Ingestion (Vite Build Time)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_APP_TITLE="SliceMart FMS"
VITE_ENABLE_MOCK=false
